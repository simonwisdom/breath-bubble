#!/bin/sh
# Builds BreathFloat.app in build/, ad-hoc signed. Run from the project folder.
set -e
cd "$(dirname "$0")/.."
swift build -c release
APP=build/BreathFloat.app
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS"
cp .build/release/BreathFloat "$APP/Contents/MacOS/BreathFloat"
cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>BreathFloat</string>
  <key>CFBundleIdentifier</key><string>com.simonwisdom.breathfloat</string>
  <key>CFBundleExecutable</key><string>BreathFloat</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST
codesign --force --sign - "$APP"
echo "built $APP"
